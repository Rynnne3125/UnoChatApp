<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<HBox prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.LoginController">

    <VBox minWidth="380.0" prefWidth="400.0" style="-fx-background-color: #F9F9F9;">
        
        <StackPane VBox.vgrow="ALWAYS">
            
            <VBox alignment="TOP_LEFT">
                <padding>
                    <Insets bottom="50" left="50" right="50" top="60" />
                </padding>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D13639; -fx-padding: 0 0 20 0;" text="UNO GAMES" />

                <VBox fx:id="loginForm" alignment="TOP_LEFT" spacing="20.0">
                    <padding><Insets top="20" /></padding>
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111;" text="Sign in" />
                    
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="USERNAME" />
                        <TextField fx:id="loginUser" promptText="Uno Master" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="PASSWORD" />
                        <PasswordField fx:id="loginPass" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    </VBox>

                    <CheckBox selected="true" style="-fx-font-size: 12px; -fx-text-fill: #666;" text="Stay signed in" />

                    <HBox alignment="CENTER" style="-fx-padding: 20 0 20 0;">
                        <Button onAction="#handleLogin" style="-fx-background-color: #D13639; -fx-text-fill: white; -fx-font-size: 20px; -fx-background-radius: 15; -fx-min-width: 60px; -fx-min-height: 60px; -fx-cursor: hand;" text="➜" />
                    </HBox>

                    <VBox spacing="5" style="-fx-padding: 40 0 0 0;">
                        <Hyperlink onAction="#switchToRegister" style="-fx-text-fill: #111; -fx-font-weight: bold; -fx-font-size: 11px;" text="CREATE ACCOUNT" />
                        <Hyperlink onAction="#switchToForgot" style="-fx-text-fill: #111; -fx-font-weight: bold; -fx-font-size: 11px;" text="CAN'T SIGN IN?" />
                    </VBox>
                </VBox>

                <VBox fx:id="registerForm" alignment="TOP_LEFT" managed="false" spacing="15.0" visible="false">
                     <padding><Insets top="20" /></padding>
                     <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111;" text="Create Account" />
                     
                     <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="EMAIL" />
                        <TextField fx:id="regEmail" promptText="example@email.com" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" />
                     </VBox>
                     
                     <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="USERNAME" />
                        <TextField fx:id="regUser" promptText="New Player" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" />
                     </VBox>
                     
                     <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="PASSWORD" />
                        <PasswordField fx:id="regPass" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" />
                     </VBox>
                     
                     <HBox alignment="CENTER" style="-fx-padding: 10 0 10 0;">
                        <Button onAction="#handlePreRegister" style="-fx-background-color: #D13639; -fx-text-fill: white; -fx-font-size: 20px; -fx-background-radius: 15; -fx-min-width: 60px; -fx-min-height: 60px; -fx-cursor: hand;" text="➜" />
                     </HBox>
                     
                     <Hyperlink onAction="#switchToLogin" style="-fx-text-fill: #111; -fx-font-weight: bold; -fx-font-size: 11px;" text="ALREADY HAVE AN ACCOUNT?" />
                </VBox>

                <VBox fx:id="otpForm" alignment="TOP_LEFT" managed="false" spacing="20.0" visible="false">
                    <padding><Insets top="20" /></padding>
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111;" text="Verify Email" />
                    <Label fx:id="otpMessageLabel" style="-fx-text-fill: #666;" text="We sent a code to your email." wrapText="true" />

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="ENTER 6-DIGIT CODE" />
                        <TextField fx:id="otpInput" alignment="CENTER" promptText="******" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 24px; -fx-font-weight: bold; -fx-letter-spacing: 5;" />
                    </VBox>

                     <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Button onAction="#handleVerifyAndCreate" style="-fx-background-color: #111; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-cursor: hand; -fx-font-weight: bold;" text="VERIFY &amp; CREATE" />
                    </HBox>
                    
                    <Hyperlink onAction="#switchToRegister" style="-fx-text-fill: #D13639; -fx-font-weight: bold; -fx-font-size: 11px;" text="← WRONG EMAIL?" />
                </VBox>

                <VBox fx:id="forgotForm" alignment="TOP_LEFT" managed="false" spacing="20.0" visible="false">
                    <padding><Insets top="20" /></padding>
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111;" text="Reset Password" />
                    <Label style="-fx-text-fill: #666;" text="Enter your email to receive a 6-digit OTP." wrapText="true" />

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #999;" text="EMAIL ADDRESS" />
                        <TextField fx:id="forgotEmail" promptText="email@domain.com" style="-fx-background-color: #EDEDED; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    </VBox>

                     <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Button onAction="#handleSendForgotPasswordOTP" style="-fx-background-color: #111; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;" text="SEND OTP" />
                    </HBox>
                    
                    <Hyperlink onAction="#switchToLogin" style="-fx-text-fill: #D13639; -fx-font-weight: bold; -fx-font-size: 11px;" text="← BACK TO SIGN IN" />
                </VBox>
            </VBox>
            
            <VBox fx:id="loadingOverlay" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.85);" visible="false">
                <ProgressIndicator prefHeight="60.0" prefWidth="60.0" style="-fx-progress-color: #D13639;" />
                <Label style="-fx-text-fill: #D13639; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 15 0 0 0;" text="Processing..." />
            </VBox>

        </StackPane>
    </VBox>

    <StackPane fx:id="rightPane" prefWidth="800.0" style="-fx-background-color: black;" HBox.hgrow="ALWAYS">
        <MediaView fx:id="bgMediaView" />
    </StackPane>

</HBox>