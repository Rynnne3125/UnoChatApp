<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<HBox prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.LoginController" fx:id="rootHBox">

    <!-- LEFT PANE: Form Area -->
    <VBox minWidth="380.0" prefWidth="420.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff 0%, #f5f7fa 100%);">

        <StackPane VBox.vgrow="ALWAYS">

            <!-- Main Content -->
            <VBox alignment="TOP_LEFT" spacing="12" style="-fx-padding: 40;">

                <!-- Header -->
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #d13639;" text="UNO GAMES" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 20 0;" text="Welcome! Sign in to play." />

                <!-- LOGIN FORM -->
                <VBox fx:id="loginForm" alignment="TOP_LEFT" spacing="16" managed="true" visible="true">
                    <padding><Insets top="10" /></padding>

                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Sign In" />

                    <!-- Username/Email Input -->
                    <HBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 15 12 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
                        <Label style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="👤" />
                        <TextField fx:id="loginUser" promptText="Username or Email" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Password Input -->
                    <HBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 15 12 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
                        <Label style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="🔒" />
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="loginPass" promptText="Password" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" />
                            <TextField fx:id="loginPassVisible" promptText="Password" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" visible="false" managed="false" />
                        </StackPane>
                        <ToggleButton fx:id="toggleLoginPass" text="👁" style="-fx-font-size: 14; -fx-padding: 2 6 2 6; -fx-background-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-text-fill: #7f8c8d;" />
                    </HBox>

                    <!-- Remember & Forgot -->
                    <HBox spacing="8" style="-fx-padding: 8 0 8 0;">
                        <CheckBox selected="true" text="Stay signed in" style="-fx-font-size: 11; -fx-text-fill: #2c3e50;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink onAction="#switchToForgot" text="Forgot password?" style="-fx-font-size: 11; -fx-padding: 0; -fx-text-fill: #3498db; -fx-underline: false;" />
                    </HBox>

                    <!-- Sign In Button -->
                    <Button onAction="#handleLogin" text="Sign In" style="-fx-font-size: 13; -fx-padding: 12 0 12 0; -fx-background-color: linear-gradient(to bottom, #d13639 0%, #b91c23 100%); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(209, 54, 57, 0.3), 8, 0, 0, 2);" />

                    <!-- Auth Links -->
                    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 16 0 0 0;">
                        <Label style="-fx-font-size: 11; -fx-text-fill: #95a5a6;" text="Don't have an account?" />
                        <Hyperlink onAction="#switchToRegister" text="Create account" style="-fx-font-size: 12; -fx-padding: 0; -fx-text-fill: #d13639; -fx-underline: false; -fx-font-weight: bold;" />
                    </VBox>
                </VBox>

                <!-- REGISTER FORM -->
                <VBox fx:id="registerForm" alignment="TOP_LEFT" managed="false" spacing="14" visible="false">
                    <padding><Insets top="10" /></padding>

                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Create Account" />

                    <!-- Email Input -->
                    <HBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 15 12 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
                        <Label style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="✉" />
                        <TextField fx:id="regEmail" promptText="Email address" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Username Input -->
                    <HBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 15 12 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
                        <Label style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="👤" />
                        <TextField fx:id="regUser" promptText="Username" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Password Input -->
                    <HBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 15 12 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
                        <Label style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="🔒" />
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="regPass" promptText="Password" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" />
                            <TextField fx:id="regPassVisible" promptText="Password" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" visible="false" managed="false" />
                        </StackPane>
                        <ToggleButton fx:id="toggleRegPass" text="👁" style="-fx-font-size: 14; -fx-padding: 2 6 2 6; -fx-background-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-text-fill: #7f8c8d;" />
                    </HBox>

                    <!-- Continue Button -->
                    <Button onAction="#handlePreRegister" text="Continue" style="-fx-font-size: 13; -fx-padding: 12 0 12 0; -fx-background-color: linear-gradient(to bottom, #d13639 0%, #b91c23 100%); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(209, 54, 57, 0.3), 8, 0, 0, 2);" />

                    <!-- Back to Login -->
                    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 12 0 0 0;">
                        <Hyperlink onAction="#switchToLogin" text="Already have an account? Sign in" style="-fx-font-size: 11; -fx-padding: 0; -fx-text-fill: #2c3e50; -fx-underline: false;" />
                    </VBox>
                </VBox>

                <!-- OTP FORM -->
                <VBox fx:id="otpForm" alignment="TOP_LEFT" managed="false" spacing="16" visible="false">
                    <padding><Insets top="10" /></padding>

                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Verify Email" />
                    <Label fx:id="otpMessageLabel" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;" text="We sent a verification code to your email." />

                    <!-- OTP Input -->
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 10; -fx-text-fill: #95a5a6; -fx-font-weight: bold;" text="6-DIGIT CODE" />
                        <TextField fx:id="otpInput" alignment="CENTER" promptText="000000" style="-fx-padding: 14 0 14 0; -fx-font-size: 24; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-color: #ffffff; -fx-background-radius: 10; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7; -fx-alignment: center; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);" />
                    </VBox>

                    <!-- Verify Button -->
                    <Button onAction="#handleVerifyAndCreate" text="Verify & Create" style="-fx-font-size: 13; -fx-padding: 12 0 12 0; -fx-background-color: linear-gradient(to bottom, #d13639 0%, #b91c23 100%); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(209, 54, 57, 0.3), 8, 0, 0, 2); -fx-padding: 20 0 20 0;" />

                    <!-- Back to Register -->
                    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 12 0 0 0;">
                        <Hyperlink onAction="#switchToRegister" text="← Wrong email? Go back" style="-fx-font-size: 11; -fx-padding: 0; -fx-text-fill: #e74c3c; -fx-underline: false;" />
                    </VBox>
                </VBox>

                <!-- FORGOT PASSWORD FORM -->
                <VBox fx:id="forgotForm" alignment="TOP_LEFT" managed="false" spacing="16" visible="false">
                    <padding><Insets top="10" /></padding>

                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Reset Password" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;" text="Enter your email. We'll send you a code to reset your password." />

                    <!-- Email Input -->
                    <HBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 15 12 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
                        <Label style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="✉" />
                        <TextField fx:id="forgotEmail" promptText="email@domain.com" style="-fx-padding: 0; -fx-font-size: 12; -fx-border-width: 0; -fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #bdc3c7;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Send OTP Button -->
                    <Button onAction="#handleSendForgotPasswordOTP" text="Send OTP" style="-fx-font-size: 13; -fx-padding: 12 0 12 0; -fx-background-color: linear-gradient(to bottom, #d13639 0%, #b91c23 100%); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(209, 54, 57, 0.3), 8, 0, 0, 2);" />

                    <!-- Back to Login -->
                    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 12 0 0 0;">
                        <Hyperlink onAction="#switchToLogin" text="← Back to sign in" style="-fx-font-size: 11; -fx-padding: 0; -fx-text-fill: #e74c3c; -fx-underline: false;" />
                    </VBox>
                </VBox>

            </VBox>

            <!-- Loading Overlay -->
            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="15" style="-fx-background-color: rgba(255, 255, 255, 0.95);" visible="false">
                <ProgressIndicator prefHeight="50.0" prefWidth="50.0" style="-fx-padding: 0;" />
                <Label style="-fx-font-size: 12; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Processing..." />
            </VBox>

        </StackPane>
    </VBox>

    <!-- RIGHT PANE: Video Background -->
    <StackPane fx:id="rightPane" prefWidth="800.0" HBox.hgrow="ALWAYS">
        <MediaView fx:id="bgMediaView" />
        <!-- Dark Gradient Overlay for Readability -->
        <StackPane style="-fx-background-color: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.4) 100%);" />
    </StackPane>

</HBox>